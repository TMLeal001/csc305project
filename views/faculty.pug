extends layout

block content
  h1 Faculty

  p ID Number: #{id}

  h2 Courses Taught

  table
    tr
      th Course
      th Term
      th Year
      th Action

    each course in courses
      tr
        td= course.CourseNo
        td= course.OffTerm
        td= course.OffYear
        td
          form(method='POST', action='/faculty/grades')
            input(type='hidden', name='id', value=id)
            input(type='hidden', name='offerNo', value=course.OfferNo)
            button(type='submit') Edit Grades

  br
  a(href='/') Back