extends layout

block content
  h1 Student

  p ID Number: #{id}

  h2 Enrolled Courses

  table
    tr
      th Course
      th Term
      th Year
      th Instructor
      th Grade

    each course in courses
      tr
        td= course.CourseNo
        td= course.OffTerm
        td= course.OffYear
        td #{course.FacFirstName} #{course.FacLastName}
        td= course.EnrGrade

  h2 Winter 2026 Courses

  table
    tr
      th Course
      th Instructor
      th Location
      th Time
      th Days
      th Action

    each course in winterCourses
      tr
        td= course.CourseNo
        td #{course.FacFirstName} #{course.FacLastName}
        td= course.OffLocation
        td= course.OffTime
        td= course.OffDays

        if course.EnrolledSSN
          td
            form(method='POST', action='/student/change')
              input(type='hidden', name='id', value=id)
              input(type='hidden', name='offerNo', value=course.OfferNo)
              input(type='hidden', name='action', value='drop')
              button(type='submit') Drop
        else
          td
            form(method='POST', action='/student/change')
              input(type='hidden', name='id', value=id)
              input(type='hidden', name='offerNo', value=course.OfferNo)
              input(type='hidden', name='action', value='enroll')
              button(type='submit') Enroll

  br
  a(href='/') Back